{
  "name": "markflow",
  "version": "2.1.0",
  "description": "A cross-platform Markdown editor with Linear-style UI",
  "main": "dist-electron/index.js",
  "author": "MarkFlow Team",
  "scripts": {
    "postinstall": "electron-builder install-app-deps && node scripts/install-eslint-ts6.mjs",
    "prepare": "husky",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ci": "npm run typecheck && npm run test:coverage",
    "lint": "node scripts/install-eslint-ts6.mjs && eslint .",
    "lint:fix": "node scripts/install-eslint-ts6.mjs && eslint . --fix",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "lint:secret": "secretlint \"**/*\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "npm run format:check && npm run lint && npm run lint:css && npm run lint:md && npm run lint:secret && npm run typecheck",
    "quality:fix": "npm run format && npm run lint:fix && npm run lint:css:fix && npm run lint:md:fix && npm run lint:secret",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "powershell -ExecutionPolicy Bypass -File scripts/prepare-win-codesign.ps1 && npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "better-sqlite3": "^13.0.3",
    "comlink": "^4.4.2",
    "dompurify": "^3.4.13",
    "franc": "^6.2.0",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.11.1",
    "i18next": "^26.3.6",
    "iconv-lite": "^0.7.3",
    "jschardet-ultra": "^2.1.0",
    "katex": "^0.18.1",
    "markdown-it": "^15.0.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-container": "^4.0.0",
    "markdown-it-front-matter": "^0.2.4",
    "markdown-it-github-alerts": "^1.0.1",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^11.16.1",
    "react-i18next": "^17.0.11"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@eslint/js": "^10.0.1",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/iconv-lite": "^0.0.1",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-container": "^4.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "7zip-bin": "^5.2.0",
    "autoprefixer": "^10.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "lucide-react": "^1.28.0",
    "markdownlint-cli2": "^0.23.2",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "secretlint": "^13.0.4",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended": "^18.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-electron": "^1.1.1",
    "vitest": "^4.1.10",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "fast-uri": "3.1.5"
  },
  "lint-staged": {
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.md": [
      "markdownlint-cli2 --fix",
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx,cjs,mjs}": [
      "node scripts/install-eslint-ts6.mjs && eslint --fix",
      "prettier --write"
    ],
    "*.{json,json5,html}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx,cjs,mjs,json,json5,html,md,css,yaml,yml,txt}": [
      "secretlint"
    ]
  }
}
