{
  "name": "markflow",
  "version": "2.2.0",
  "description": "A cross-platform Markdown editor with Linear-style UI",
  "main": "dist-electron/index.js",
  "type": "module",
  "author": "MarkFlow Team",
  "scripts": {
    "postinstall": "node scripts/install-eslint-ts6.mjs",
    "prepare": "husky",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test --project=electron-app --project=electron-perf-gate",
    "e2e:perf": "playwright test --project=electron-perf",
    "verify": "npm run quality:fix && npm run test:coverage && npm run build && playwright test --project=electron-app",
    "verify:full": "npm run quality:fix && npm run test:coverage && npm run build && npm run e2e",
    "lint": "node scripts/install-eslint-ts6.mjs && eslint . --max-warnings=0",
    "lint:fix": "node scripts/install-eslint-ts6.mjs && eslint . --fix --max-warnings=0",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "lint:secret": "secretlint \"**/*\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "npm run format:check && npm run lint && npm run lint:css && npm run lint:md && npm run lint:secret && npm run typecheck",
    "quality:fix": "npm run format && npm run lint:fix && npm run lint:css:fix && npm run lint:md:fix && npm run lint:secret && npm run typecheck",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "powershell -ExecutionPolicy Bypass -File scripts/prepare-win-codesign.ps1 && npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "build:action": "npm --prefix actions/create-pr run build",
    "local-test-render": "node actions/create-pr/src/cli-render.mjs --head feature/my-branch"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "chokidar": "^5.0.0",
    "comlink": "^4.4.2",
    "dompurify": "^3.4.14",
    "franc": "^6.2.0",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.11.2",
    "i18next": "^26.4.0",
    "iconv-lite": "^0.7.3",
    "jschardet-ultra": "^2.1.0",
    "katex": "^0.18.4",
    "markdown-it": "^15.0.1",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-container": "^4.0.0",
    "markdown-it-front-matter": "^0.2.4",
    "markdown-it-github-alerts": "^1.0.1",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^11.17.2",
    "minisearch": "^7.2.0",
    "react-i18next": "^17.0.12"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@eslint/js": "^10.0.1",
    "@lezer/highlight": "^1.2.3",
    "@playwright/test": "^1.62.1",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/iconv-lite": "^0.0.1",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-container": "^4.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "7zip-bin": "^5.2.0",
    "autoprefixer": "^10.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "lucide-react": "^1.38.0",
    "markdownlint-cli2": "^0.23.2",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "secretlint": "^13.0.5",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended": "^18.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-electron": "^1.1.1",
    "vitest": "^4.1.11",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "fast-uri": "3.1.5"
  },
  "lint-staged": {
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.md": [
      "markdownlint-cli2 --fix",
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx,cjs,mjs}": [
      "node scripts/install-eslint-ts6.mjs && eslint --fix",
      "prettier --write"
    ],
    "*.{json,json5,html}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx,cjs,mjs,json,json5,html,md,css,yaml,yml,txt}": [
      "secretlint"
    ]
  }
}
