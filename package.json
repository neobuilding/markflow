{
  "name": "markflow",
  "version": "2.2.0",
  "description": "A cross-platform Markdown editor with Linear-style UI",
  "main": "dist/electron/index.js",
  "type": "module",
  "author": "MarkFlow Team",
  "scripts": {
    "postinstall": "node scripts/install-eslint-ts6.mjs",
    "prepare": "husky",
    "precommit": "lint-staged --max-arg-length=4096",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e:app": "playwright test --project=e2e-app",
    "e2e:perf-diag": "playwright test --project=e2e-perf-diag",
    "e2e:perf-gate": "playwright test --project=e2e-perf-gate",
    "e2e:full": "playwright test --project=e2e-app --project=e2e-perf-gate",
    "verify": "npm run quality:fix && npm run test:coverage && npm run build",
    "verify:app": "npm run quality:fix && npm run test:coverage && npm run build && npm run e2e:app",
    "verify:full": "npm run quality:fix && npm run test:coverage && npm run build && npm run e2e:full",
    "lint": "node scripts/install-eslint-ts6.mjs && eslint . --max-warnings=0",
    "lint:fix": "node scripts/install-eslint-ts6.mjs && eslint . --fix --max-warnings=0",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "lint:secret": "secretlint \"**/*\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "npm run format:check && npm run lint && npm run lint:css && npm run lint:md && npm run lint:secret && npm run typecheck",
    "quality:fix": "npm run format && npm run lint:fix && npm run lint:css:fix && npm run lint:md:fix && npm run lint:secret && npm run typecheck",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "powershell -ExecutionPolicy Bypass -File scripts/prepare-win-codesign.ps1 && npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "build:action": "npm --prefix actions/create-pr run build",
    "local-test-render": "node actions/create-pr/src/cli-render.mjs --head feature/my-branch",
    "test:integration": "node --experimental-vm-modules node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "chokidar": "^6.0.0",
    "comlink": "^4.4.2",
    "dompurify": "^3.4.17",
    "franc": "^6.2.0",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.12.0",
    "i18next": "^26.5.7",
    "iconv-lite": "^0.7.3",
    "image-size": "^2.0.4",
    "jschardet-ultra": "^2.1.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-front-matter": "^0.2.4",
    "markdown-it-github-alerts": "^1.0.1",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^12.2.0",
    "minisearch": "^7.2.0",
    "morphdom": "^2.7.8",
    "picomatch": "^4.0.7",
    "react-i18next": "^17.1.5"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@eslint/js": "^10.0.1",
    "@lezer/highlight": "^1.2.5",
    "@playwright/test": "^1.64.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/iconv-lite": "^0.0.1",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-container": "^4.0.1",
    "@types/node": "^26.6.5",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "7zip-bin": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "lucide-react": "^1.61.0",
    "markdownlint-cli2": "^0.24.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "secretlint": "^13.0.7",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  },
  "overrides": {
    "fast-uri": "3.1.5"
  },
  "lint-staged": {
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.md": [
      "markdownlint-cli2 --fix",
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx,cjs,mjs}": [
      "node scripts/install-eslint-ts6.mjs",
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,json5,html}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx,cjs,mjs,json,json5,html,md,css,yaml,yml,txt}": [
      "secretlint"
    ]
  }
}
