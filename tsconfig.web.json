{
  "extends": "./tsconfig.json",
  "include": ["src/renderer/src/**/*.ts", "src/renderer/src/**/*.tsx", "shared/**/*.ts"],
  "exclude": [
    "src/renderer/src/**/*.test.ts",
    "src/renderer/src/**/*.test.tsx",
    "shared/**/*.test.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo-renderer.json",
    "jsx": "react-jsx",
    // ES2022 (not ES2021): `Intl.Segmenter` backs whole-word matching (ADR-0023 D35) and the
    // main-process build already compiles against ES2022.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "moduleResolution": "Bundler"
  }
}
