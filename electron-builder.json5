{
  appId: 'com.markflow.app',
  productName: 'MarkFlow',
  directories: {
    buildResources: 'resources',
    output: 'release',
  },
  fileAssociations: [
    { ext: 'md', name: 'Markdown Document', role: 'Editor' },
    { ext: 'markdown', name: 'Markdown Document', role: 'Editor' },
    { ext: 'mdx', name: 'Markdown Document', role: 'Editor' },
    { ext: 'mdtxt', name: 'Markdown Document', role: 'Editor' },
    { ext: 'mdtext', name: 'Markdown Document', role: 'Editor' },
  ],
  files: [
    'dist-electron/**/*',
    'dist/renderer/**/*',
    '!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,caches,lock}',
    '!.eslintrc.{js,yml,yaml}',
    '!.prettier*',
    '!.editorconfig',
    '!*.{spec,test}.{js,ts}',
    '!**/{.DS_Store,Thumbs.db,desktop.ini}',
    '!**/node_modules/.bin',
  ],
  asarUnpack: ['node_modules/better-sqlite3/**'],
  mac: {
    // better-sqlite3 ships per-arch prebuilds (darwin-x64.node / darwin-arm64.node) that are
    // byte-identical in both the x64 and arm64 app bundles. @electron/universal requires such
    // Mach-O files to be explicitly declared as x64-arch files, otherwise it throws
    // "Detected file ... that's the same in both x64 and arm64 builds and not covered by the
    // x64ArchFiles rule". Marking both darwin prebuilds keeps the correct binaries in place:
    // the x64 bundle's darwin-arm64.node copy is the real arm64 binary (and vice-versa), so the
    // universal app loads the right one per architecture at runtime.
    x64ArchFiles: '**/node_modules/better-sqlite3/prebuilds/darwin-*.node',
    entitlementsInherit: 'resources/entitlements.mac.plist',
    extendInfo: {
      NSCameraUsageDescription: "Application requests access to the device's camera.",
      NSMicrophoneUsageDescription: "Application requests access to the device's microphone.",
      NSDocumentsFolderUsageDescription: "Application requests access to the user's Documents folder.",
      NSDownloadsFolderUsageDescription: "Application requests access to the user's Downloads folder.",
    },
    notarize: false,
    target: [
      {
        target: 'dmg',
        arch: ['universal'],
      },
    ],
  },
  win: {
    executableName: 'MarkFlow',
    target: [
      {
        target: 'zip',
        arch: ['x64'],
      },
    ],
    artifactName: '${name}-${version}-${os}.${ext}',
  },
  linux: {
    target: [
      {
        target: 'AppImage',
        arch: ['x64'],
      },
    ],
  },
  dmg: {
    artifactName: '${name}-${version}.${ext}',
  },
  publish: null,
}
