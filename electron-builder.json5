{
  appId: 'com.markflow.app',
  productName: 'MarkFlow',
  directories: {
    buildResources: 'resources',
    output: 'release',
  },
  // Print where the packaged app landed, once all artifacts are built.
  afterAllArtifactBuild: './scripts/after-all-artifact-build.mjs',
  // `asar` is a boolean in electron-builder 26 (AsarOptions only accepts `ordering` /
  // `smartUnpack`); it defaults to true, so app sources are packed into app.asar already.
  // Archive compression is `normal` for every target, not `maximum`: for zip targets
  // electron-builder adds -mfb=258 -mpass=15 at `maximum`, which makes compression
  // dramatically slower for a negligible size gain and dominated the Windows CI job.
  // This is a root-level option: dmg and AppImage switch to their default compression
  // too. Rejected alternatives: `maximum` (above), `ELECTRON_BUILDER_COMPRESSION_LEVEL`
  // (would make local and CI disagree), and `asar: { compression: ... }` (invalid in
  // electron-builder 26: AsarOptions only accepts `ordering` / `smartUnpack`).
  // No native modules are bundled, so no asarUnpack is needed.
  compression: 'normal',
  fileAssociations: [
    { ext: 'md', name: 'Markdown Document', role: 'Editor' },
    { ext: 'markdown', name: 'Markdown Document', role: 'Editor' },
    { ext: 'mdx', name: 'Markdown Document', role: 'Editor' },
    { ext: 'mdtxt', name: 'Markdown Document', role: 'Editor' },
    { ext: 'mdtext', name: 'Markdown Document', role: 'Editor' },
  ],
  files: [
    'dist/electron/**/*',
    'dist/renderer/**/*',
    '!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,caches,lock}',
    '!.eslintrc.{js,yml,yaml}',
    '!.prettier*',
    '!.editorconfig',
    '!*.{spec,test}.{js,ts}',
    '!**/*.map',
    '!**/{.DS_Store,Thumbs.db,desktop.ini}',
    // Both builds are FULLY BUNDLED by Vite: `dist/electron/index.js` (main + preload)
    // has no bare `require()` except Node builtins, and the renderer is a self-contained
    // set of chunks. Shipping `node_modules` too was 91.8 MB of pure duplication
    // (mermaid 41 MB, cytoscape-fcose 9 MB, elkjs 8 MB, highlight.js 5 MB, …) — see
    // ADR-0015. Only drop this exclusion if something ever needs a runtime dependency
    // again; verify by launching `release/win-unpacked/MarkFlow.exe`.
    '!node_modules',
    '!node_modules/**/*',
  ],
  mac: {
    entitlementsInherit: 'resources/entitlements.mac.plist',
    extendInfo: {
      NSCameraUsageDescription: "Application requests access to the device's camera.",
      NSMicrophoneUsageDescription: "Application requests access to the device's microphone.",
      NSDocumentsFolderUsageDescription: "Application requests access to the user's Documents folder.",
      NSDownloadsFolderUsageDescription: "Application requests access to the user's Downloads folder.",
    },
    notarize: false,
    target: [
      {
        target: 'dmg',
        arch: ['universal'],
      },
    ],
  },
  win: {
    executableName: 'MarkFlow',
    // MarkFlow ships the Windows exe UNSIGNED — see ADR-0037. electron-builder 26 edits
    // icon/version resources with pure-JS resedit (independent of signing), so disabling
    // signing here only removes the otherwise-misleading system-signtool attempt; the
    // prepare-win-codesign.ps1 pre-cache script was removed because electron-builder 26
    // never consumed the toolset it extracted.
    signExecutable: false,
    target: [
      {
        target: 'zip',
        arch: ['x64'],
      },
    ],
    artifactName: '${name}-${version}-${os}.${ext}',
  },
  linux: {
    target: [
      {
        target: 'AppImage',
        arch: ['x64'],
      },
    ],
  },
  dmg: {
    artifactName: '${name}-${version}.${ext}',
  },
  publish: null,
}
