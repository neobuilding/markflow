{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo-tests.json",
    "noEmit": true,
    "jsx": "react-jsx",
    // ES2022 (not ES2021): `Intl.Segmenter` backs whole-word matching (ADR-0023 D35) and the
    // main-process build already compiles against ES2022.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vitest/globals", "node"],
    "moduleResolution": "Bundler",
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "@main/*": ["./electron/main/*"],
      "@/*": ["./src/renderer/src/*"]
    }
  },
  "include": [
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.tsx",
    "electron/main/**/*.ts",
    "electron/preload/**/*.ts",
    "shared/**/*.ts",
    "scripts/**/*.mjs",
    "scripts/**/*.ts",
    "test-setup.ts",
    "e2e/**/*.ts"
  ]
}
