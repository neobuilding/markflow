{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo-tests.json",
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "types": ["vitest/globals", "node"],
    "moduleResolution": "Bundler",
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "@main/*": ["./electron/main/*"],
      "@/*": ["./src/renderer/src/*"]
    }
  },
  "include": [
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.tsx",
    "electron/main/**/*.ts",
    "electron/preload/**/*.ts",
    "shared/**/*.ts",
    "test-setup.ts"
  ]
}
